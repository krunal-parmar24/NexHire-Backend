{
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_PROD_HOST;Database=NexHire;Username=YOUR_USER;Password=YOUR_PASSWORD"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_PRODUCTION_SECRET",
